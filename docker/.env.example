# Copy to docker/.env and fill in. Never commit the real file.

# URL users open in the browser (behind your reverse proxy, with https)
RZ_PUBLIC_URL=https://laps.example.com

# 32 random bytes: openssl rand -base64 32
# Encrypts two-factor secrets. Keep it; changing it disables everyone's 2FA.
RZ_SECRET_KEY=

# Database password: openssl rand -base64 24
POSTGRES_PASSWORD=

# First admin, created on the first start only (then you can remove these)
RZ_ADMIN_USERNAME=admin
RZ_ADMIN_PASSWORD=

# Use X-Forwarded-For from the reverse proxy for rate limiting and logs
RZ_TRUST_PROXY=true
